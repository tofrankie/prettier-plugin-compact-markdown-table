{
  "name": "@tofrankie/prettier-plugin-compact-markdown-table",
  "type": "module",
  "version": "0.0.2",
  "packageManager": "pnpm@10.34.0",
  "description": "Prettier plugin for compact markdown tables without cell padding or alignment",
  "author": "Frankie <1426203851@qq.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/tofrankie/prettier-plugin-compact-markdown-table",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tofrankie/prettier-plugin-compact-markdown-table.git"
  },
  "bugs": {
    "url": "https://github.com/tofrankie/prettier-plugin-compact-markdown-table/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "prettier-plugin",
    "markdown",
    "markdown-table",
    "token-optimization",
    "prompt-engineering",
    "formatter"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "test": "vitest run",
    "lint": "run-s lint:eslint lint:prettier typecheck",
    "lint:eslint": "eslint . --fix",
    "lint:prettier": "pnpm build && prettier . --write",
    "lint:prettier:check": "pnpm build && prettier . --check",
    "typecheck": "tsc --noEmit",
    "github:release": "tfr",
    "prepublishOnly": "run-s test typecheck"
  },
  "peerDependencies": {
    "prettier": "^3.0.0"
  },
  "devDependencies": {
    "@tofrankie/action": "^0.0.9",
    "@tofrankie/eslint": "^0.5.0",
    "@tofrankie/prettier": "^0.2.0",
    "@tofrankie/tsconfig": "^0.2.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.6",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
